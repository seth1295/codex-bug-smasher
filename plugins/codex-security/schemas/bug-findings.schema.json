{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "functional-bug://schemas/findings.schema.json",
  "title": "Functional bug scan findings",
  "type": "object",
  "required": ["documentType", "schemaVersion", "scanId", "findings", "hypotheses"],
  "properties": {
    "documentType": {"const": "functional-bug-scan.findings"},
    "schemaVersion": {"const": "1.0"},
    "scanId": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "findingId", "occurrenceId", "ruleId", "identity", "fingerprints",
          "title", "summary", "priority", "category", "confidence", "locations",
          "expected", "actual", "impact", "validation", "provenance"
        ],
        "properties": {
          "findingId": {"type": "string", "pattern": "^bug_[a-f0-9]{24}$"},
          "occurrenceId": {"type": "string", "pattern": "^occ_[a-f0-9]{24}$"},
          "ruleId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
          "identity": {
            "type": "object",
            "required": ["anchor"],
            "properties": {
              "anchor": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
              "instance": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"}
            },
            "additionalProperties": true
          },
          "fingerprints": {
            "type": "object",
            "required": ["algorithm", "primary"],
            "properties": {
              "algorithm": {"const": "functional-bug/v1"},
              "primary": {"type": "string", "pattern": "^functional-bug/v1:sha256:[a-f0-9]{64}$"}
            },
            "additionalProperties": true
          },
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "category": {"type": "string", "minLength": 1},
          "confidence": {
            "type": "object",
            "required": ["level", "rationale"],
            "properties": {
              "level": {"enum": ["high", "medium", "low"]},
              "rationale": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "startLine"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "startLine": {"type": "integer", "minimum": 1},
                "endLine": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": true
            }
          },
          "expected": {"type": "string", "minLength": 1},
          "actual": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "rootCause": {"type": "string", "minLength": 1},
          "reachability": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "properties": {
                  "entrypoint": {"type": "string", "minLength": 1},
                  "steps": {"type": "array", "items": {"type": "string", "minLength": 1}},
                  "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
                },
                "additionalProperties": true
              }
            ]
          },
          "validation": {
            "type": "object",
            "required": ["status", "method", "evidence"],
            "properties": {
              "status": {"const": "validated"},
              "method": {"type": "string", "minLength": 1},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "reproduction": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "counterEvidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": true
          },
          "suggestedCorrection": {"type": "string", "minLength": 1},
          "tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "provenance": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "sourceFindingIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "sourceFindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "finding"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "finding": {"type": "object", "additionalProperties": true}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          },
          "extensions": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "hypotheses": {
      "type": "array",
      "description": "Unresolved candidate bugs, separate from validated findings.",
      "items": {"type": "object", "additionalProperties": true}
    }
  },
  "additionalProperties": false
}
